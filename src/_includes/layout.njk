<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#1a1a1a" />

  <title>{{ title or settings.seo.title }}</title>

  {% set desc = description or settings.seo.description %}
  <meta name="description" content="{{ desc }}" />
  <meta name="keywords" content="plaster, gyprock, plastering, cornices, insulation, framing, plasterboard, float and set, rendering, Australia, {{ settings.companyName }}" />
  <meta name="author" content="{{ settings.companyName }}" />
  <meta name="robots" content="index, follow" />

  <link rel="canonical" href="https://gyopro.com.au/" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ settings.companyName }}" />
  <meta property="og:title" content="{{ title or settings.seo.title }}" />
  <meta property="og:description" content="{{ desc }}" />
  <meta property="og:url" content="https://gyopro.com.au/" />
  <meta property="og:image" content="https://gyopro.com.au/assets/img/og-image.jpg" />
  <meta property="og:locale" content="en_AU" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ title or settings.seo.title }}" />
  <meta name="twitter:description" content="{{ desc }}" />
  <meta name="twitter:image" content="https://gyopro.com.au/assets/img/og-image.jpg" />

  <!-- Icons -->
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon.png" />

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/assets/css/main.css" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HomeAndConstructionBusiness",
    "name": "{{ settings.companyName }}",
    "alternateName": "{{ settings.brandShort }}",
    "url": "https://gyopro.com.au/",
    "logo": "https://gyopro.com.au/assets/img/图2.jpg",
    "image": "https://gyopro.com.au/assets/img/og-image.jpg",
    "description": "{{ desc }}",
    "telephone": "{{ settings.contacts.elsa.phone | telLink }}",
    "email": "{{ settings.contacts.email }}",
    "priceRange": "$$",
    "areaServed": {
      "@type": "Country",
      "name": "Australia"
    },
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "AU"
    },
    "taxID": "{{ settings.abn }}",
    "identifier": "{{ settings.abn }}",
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "telephone": "{{ settings.contacts.elsa.phone | telLink }}",
        "contactType": "customer service",
        "availableLanguage": ["English"],
        "name": "{{ settings.contacts.elsa.name }}"
      },
      {
        "@type": "ContactPoint",
        "telephone": "{{ settings.contacts.yao.phone | telLink }}",
        "contactType": "customer service",
        "availableLanguage": ["Chinese"],
        "name": "{{ settings.contacts.yao.name }}"
      }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Plaster & Gyprock Services",
      "itemListElement": [
        {%- for svc in services %}
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "{{ svc.name }}" } }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
  }
  </script>
</head>

<body>
  {% include "header.njk" %}

  <main>
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}
  {% include "cookie-banner.njk" %}

  <script src="/assets/js/main.js"></script>
</body>
</html>