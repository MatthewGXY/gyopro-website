---
layout: layout.njk
eleventyComputed:
  title: "{{ settings.seo.title | safe }}"
  description: "{{ settings.seo.description | safe }}"
---

<!-- ============ HERO ============ -->
<section id="hero" class="hero">
  <div class="container hero-grid">
    <div class="hero-text">
      <p class="eyebrow">{{ settings.tagline }}</p>
      <h1>{{ settings.heroTitle | nl2br | safe }}</h1>
      <p class="lede">{{ settings.heroLede }}</p>

      <ul class="hero-contacts" aria-label="Contact">
        <li>
          <span class="contact-label">{{ settings.contacts.elsa.name }} ({{ settings.contacts.elsa.lang }})</span>
          <a href="tel:{{ settings.contacts.elsa.phone | telLink }}">{{ settings.contacts.elsa.phone }}</a>
        </li>
        <li>
          <span class="contact-label">{{ settings.contacts.yao.name }} ({{ settings.contacts.yao.lang }})</span>
          <a href="tel:{{ settings.contacts.yao.phone | telLink }}">{{ settings.contacts.yao.phone }}</a>
        </li>
        <li>
          <span class="contact-label">Email</span>
          <a href="mailto:{{ settings.contacts.email }}">{{ settings.contacts.email }}</a>
        </li>
      </ul>

      <a href="#contact" class="btn-primary">Request a quote</a>
    </div>

    <div class="hero-photos">
      <div class="photo-tile tile-1"><img src="/assets/photos/hero/01-living-room.jpg" alt="Completed living room with plasterboard ceiling and feature bulkhead" loading="lazy" /></div>
      <div class="photo-tile tile-2"><img src="/assets/photos/hero/02-framing.jpg" alt="Timber wall framing ready for plasterboard" loading="lazy" /></div>
      <div class="photo-tile tile-3"><img src="/assets/photos/hero/03-vault-ceiling.jpg" alt="Vaulted ceiling with plasterboard lining and insulation" loading="lazy" /></div>
      <div class="photo-tile tile-4"><img src="/assets/photos/hero/04-plasterboard.jpg" alt="Plasterboard sheets installed on ceiling" loading="lazy" /></div>
    </div>
  </div>
</section>

<!-- ============ SERVICES ============ -->
<section id="services" class="services">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">What we do</p>
      <h2>Specialists in Gyprock Ceilings &amp; Walls<br />for Commercial and Residential Projects.</h2>
    </header>

    <ul class="service-grid">
      {%- for svc in services %}
        {% include "service-card.njk" %}
      {%- endfor %}
    </ul>
  </div>
</section>

<!-- ============ PROJECTS ============ -->
<section id="projects" class="projects">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">Selected work</p>
      <h2>Recent projects</h2>
      <p class="section-sub">A snapshot of recent commercial and residential jobs across Australia.</p>
    </header>

    <ul class="project-grid">
      <li class="project-card"><img src="/assets/photos/gallery/01-framing-walkthrough.jpg" alt="Walkthrough of timber wall framing during fit-out" loading="lazy" /></li>
      <li class="project-card"><img src="/assets/photos/gallery/02-plasterboard-floor.jpg" alt="Ram Board protection on concrete floor with scaffold staged for ceiling" loading="lazy" /></li>
      <li class="project-card"><img src="/assets/photos/gallery/03-feature-ceiling.jpg" alt="Recessed feature ceiling with bulkhead and cove lighting" loading="lazy" /></li>
      <li class="project-card"><img src="/assets/photos/gallery/04-vault-ceiling-progress.jpg" alt="Vaulted ceiling with plasterboard partially installed" loading="lazy" /></li>
      <li class="project-card"><img src="/assets/photos/gallery/05-bulkhead-detail.jpg" alt="Detail view of plasterboard bulkhead transition" loading="lazy" /></li>
      <li class="project-card"><img src="/assets/photos/gallery/06-large-room-framing.jpg" alt="Large open-plan room with timber ceiling framing" loading="lazy" /></li>

      <li class="project-card project-card--extra"><img src="/assets/photos/gallery/07-entryway-arch-ceiling.jpg" alt="Finished entryway with arched plasterboard bulkhead and French doors" loading="lazy" /></li>
      <li class="project-card project-card--extra"><img src="/assets/photos/gallery/08-wall-repair-prep.jpg" alt="Patchy wall surface prepared for skim coat" loading="lazy" /></li>
      <li class="project-card project-card--extra"><img src="/assets/photos/gallery/09-vaulted-void-timber-beams.jpg" alt="Double-height void with exposed timber beams and plasterboard ceiling" loading="lazy" /></li>
    </ul>

    <div class="projects-actions">
      <button type="button" id="projects-toggle" class="btn-primary" aria-expanded="false" aria-controls="project-extra-list">
        <span class="projects-toggle-label">View more</span>
        <svg class="projects-toggle-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</section>

<!-- ============ CONTACT ============ -->
<section id="contact" class="contact">
  <div class="container contact-grid">
    <div>
      <p class="eyebrow">Get in touch</p>
      <h2>Talk to us about your project.</h2>
      <p class="lede">
        Whether it's a small residential patch or a multi-storey commercial fit-out,
        we'd love to hear about it. Call, email, or send us your plans.
      </p>
    </div>

    <ul class="contact-cards">
      <li>
        <h3>{{ settings.contacts.elsa.name }} <span class="lang-tag">{{ settings.contacts.elsa.lang }}</span></h3>
        <a href="tel:{{ settings.contacts.elsa.phone | telLink }}" class="contact-line">{{ settings.contacts.elsa.phone }}</a>
      </li>
      <li>
        <h3>{{ settings.contacts.yao.name }} <span class="lang-tag">{{ settings.contacts.yao.lang }}</span></h3>
        <a href="tel:{{ settings.contacts.yao.phone | telLink }}" class="contact-line">{{ settings.contacts.yao.phone }}</a>
      </li>
      <li>
        <h3>Email</h3>
        <a href="mailto:{{ settings.contacts.email }}" class="contact-line">{{ settings.contacts.email }}</a>
      </li>
    </ul>
  </div>
</section>